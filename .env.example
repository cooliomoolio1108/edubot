# ===========================
# ENVIRONMENT SETTINGS
# ===========================
ENV=local

# ===========================
# BACKEND API
# ===========================
FLASK_API_URL=http://localhost:5050

# ===========================
# AZURE OPENAI SETTINGS
# ===========================
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZ_OPENAI_ENDPOINT=https://<your-endpoint>.cognitiveservices.azure.com/openai/deployments/<deployment-name>/chat/completions?api-version=<version>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# ===========================
# EMBEDDING MODEL
# ===========================
EMBED_ENDPOINT=https://<your-endpoint>.cognitiveservices.azure.com/openai/deployments/<embed-deploy-name>/embeddings?api-version=<version>
EMBED_DEPLOY_NAME=text-embedding-3-large

# ===========================
# MICROSOFT AUTH / SSO
# ===========================
CLIENT_ID=YOUR_CLIENT_ID
TENANT_ID=YOUR_TENANT_ID
CLIENT_SECRET=YOUR_CLIENT_SECRET
REDIRECT_URI=http://localhost:5050/auth/callback
AUTHORITY=https://login.microsoftonline.com/${TENANT_ID}

# ===========================
# FRONTEND
# ===========================
STREAMLIT_URL=http://localhost:8501

# ===========================
# SECRETS
# ===========================
JWT_SECRET=YOUR_JWT_SECRET
FLASK_SECRET_KEY=YOUR_FLASK_SECRET_KEY

# ===========================
# AUTH ROUTES
# ===========================
FLASK_LOGIN=http://localhost:5050/auth/login
CALLBACK=http://localhost:5050/auth/getAuth

# ===========
